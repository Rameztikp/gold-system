{
  "name": "gold-system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply gold-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply gold-db --remote",
    "deploy": "vite build && wrangler deploy",
    "check": "npm run typecheck && npm run lint && npm run test",
    "e2e": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "better-sqlite3": "^13.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}